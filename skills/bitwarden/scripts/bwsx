#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: bwsx <handle> <bws args...>" >&2
    exit 1
fi

handle="$1"
shift

BWS_ACCESS_TOKEN="$(bws-token "$handle")"
if [[ -z "$BWS_ACCESS_TOKEN" ]]; then
    echo "bwsx: empty token returned for handle '$handle'" >&2
    exit 1
fi
export BWS_ACCESS_TOKEN

exec bws "$@"
