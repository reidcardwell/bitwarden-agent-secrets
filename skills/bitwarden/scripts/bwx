#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: bwx <handle> <bw args...>" >&2
    exit 1
fi

handle="$1"
shift

BW_SESSION="$(bw-unlock "$handle")"
if [[ -z "$BW_SESSION" ]]; then
    echo "bwx: empty session token returned for handle '$handle'" >&2
    exit 1
fi
export BW_SESSION

exec bw "$@"
